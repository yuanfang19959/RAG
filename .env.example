# 复制为 .env 后按需修改（.env 不要提交）
APP_NAME=rag
APP_VERSION=0.1.0

# 本机 Homebrew PostgreSQL 16 + pgvector，库名 rag_db
DATABASE_URL=postgresql+asyncpg://your-user@127.0.0.1:5432/rag_db
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# 上传与切块（可不填，用默认值）
UPLOAD_DIR=uploads
CHUNK_SIZE=500
CHUNK_OVERLAP=80

# 嵌入模型：硅基流动（OpenAI 兼容接口），bge-m3 输出 1024 维
SILICONFLOW_API_KEY=sk-your-key-here
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=Pro/BAAI/bge-m3

# P2 生成回答时用
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
